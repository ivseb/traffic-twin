        { "id": "shipment-in-transit", "entity": "shipment", "target": "shipment-created", "set": { "status": "IN_TRANSIT" }, "after_effect": "shipment-created", "after": { "min": "1h", "max": "6h" } }
      ],
      "outcomes": [
        { "name": "happy", "p": 0.97, "effects": ["shipment-created", "shipment-in-transit"] },
        { "name": "never-shipped", "p": 0.03, "effects": [] }
      ],
