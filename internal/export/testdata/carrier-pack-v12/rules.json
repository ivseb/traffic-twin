  "rules": [
    {
      "id": "r-0007",
      "kind": "causal",
      "status": "approved",
      "title": "A created order creates a shipment at the carrier",
      "cause": {
        "service": "shop-api",
        "op": "POST /orders",
        "when": { "status": [201] },
        "bind": { "order": { "from": "resp.body", "path": "$.id" } }
      },
      "effects": [
        { "id": "shipment-requested", "entity": "shipment", "create": { "orderId": "${order}", "status": "PENDING" }, "after": "0s" },
        { "id": "order-linked", "entity": "order", "target_id": "${order}", "set": { "shipmentId": "${effect:shipment-requested}" }, "after_effect": "shipment-requested", "after": "0s" },
        { "id": "shipment-created", "entity": "shipment", "target": "shipment-requested", "set": { "status": "CREATED" }, "after_effect": "shipment-requested", "after": { "min": "2m", "max": "10m" } },
        { "id": "shipment-in-transit", "entity": "shipment", "target": "shipment-requested", "set": { "status": "IN_TRANSIT" }, "after_effect": "shipment-created", "after": { "min": "1h", "max": "6h" } },
        { "id": "shipment-delivered", "entity": "shipment", "target": "shipment-requested", "set": { "status": "DELIVERED" }, "after_effect": "shipment-in-transit", "after": { "min": "6h", "max": "36h" } },
        { "id": "shipment-cancelled", "entity": "shipment", "target": "shipment-requested", "set": { "status": "CANCELLED" }, "after_effect": "shipment-created", "after": { "min": "30m", "max": "4h" } }
      ],
      "outcomes": [
        { "name": "happy", "p": 0.93, "effects": ["shipment-requested", "order-linked", "shipment-created", "shipment-in-transit", "shipment-delivered"] },
        { "name": "cancelled", "p": 0.04, "effects": ["shipment-requested", "order-linked", "shipment-created", "shipment-cancelled"] },
        { "name": "never-shipped", "p": 0.03, "effects": ["shipment-requested", "order-linked"] }
      ],
      "evidence": {
        "counts": { "causes": 4120, "distinct_subjects": 1310, "outcomes": { "happy": 3832, "cancelled": 165, "never-shipped": 123 } }
      }
    },
    {
      "id": "r-0008",
      "kind": "causal",
      "status": "approved",
      "title": "A shipment asked to the carrier becomes visible and is delivered",
      "cause": {
        "service": "shipping-ext",
