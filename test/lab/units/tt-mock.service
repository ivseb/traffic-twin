[Unit]
Description=traffic-twin mock (tt mock) serving the latest published pack
Documentation=https://github.com/ivseb/traffic-twin
After=network-online.target
Wants=network-online.target
# Starts only once the e2e script has put a pack in place.
ConditionPathExists=/opt/tt-lab/packs/current.ttpack

[Service]
Type=simple
User=tt-mock
Group=tt-mock
# TT_GATE_PUBKEYS (public keys of keyguard's pack signing key) and
# TT_CONTROL_TOKEN (required on a non-loopback address).
EnvironmentFile=/etc/tt-mock/mock.env
ExecStart=/usr/local/bin/tt mock --pack /opt/tt-lab/packs/current.ttpack --addr 0.0.0.0:8480 --latency record --quiet
Restart=on-failure
RestartSec=2s
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RemoveIPC=yes
ReadOnlyPaths=/opt/tt-lab/packs

[Install]
WantedBy=multi-user.target
