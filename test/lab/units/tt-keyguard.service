[Unit]
Description=traffic-twin keyguard (key custodian, mTLS)
Documentation=https://github.com/ivseb/traffic-twin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tt-keyguard
Group=tt-keyguard
# Paths and pins only: the keys themselves are 0400 files read through the
# *_FILE variables, never in the environment.
EnvironmentFile=/etc/tt-keyguard/keyguard.env
ExecStart=/usr/local/bin/tt keyguard
Restart=on-failure
RestartSec=2s

StateDirectory=tt-keyguard
StateDirectoryMode=0700
UMask=0077

# Sandbox
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RemoveIPC=yes
# keyguard talks only to tt-core: nothing else may reach it or be reached.
# deploy-infra.sh replaces __CORE_ALLOW_IP__ with LAB_CORE_ALLOW_IP.
IPAddressDeny=any
IPAddressAllow=__CORE_ALLOW_IP__ 127.0.0.0/8
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
