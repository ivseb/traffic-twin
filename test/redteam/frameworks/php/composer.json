{
    "name": "rt/rt3fw-symfony",
    "type": "project",
    "description": "Red team round 3: Symfony 7 micro-kernel app with the traffic-twin PHP SDK (SymfonySubscriber).",
    "require": {
        "php": ">=8.3",
        "symfony/framework-bundle": "7.1.*",
        "symfony/yaml": "7.1.*",
        "traffic-twin/sdk": "*@dev"
    },
    "repositories": [
        { "type": "path", "url": "/sdk-php", "options": { "symlink": false } }
    ],
    "autoload": { "psr-4": { "App\\": "src/" } },
    "config": { "sort-packages": true, "allow-plugins": { "php-http/discovery": false } }
}
