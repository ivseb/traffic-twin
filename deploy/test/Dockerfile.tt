# syntax=docker/dockerfile:1
#
# Development image of the tt binary for the Kubernetes end-to-end test (deploy/test/kind-e2e.sh):
# same runtime as the release Dockerfile, but without the UI build (the embedded UI is the placeholder).
# Build from the repository root:  docker build -f deploy/test/Dockerfile.tt -t tt:e2e .

FROM --platform=$BUILDPLATFORM golang:1.25-alpine@sha256:1ae0735f00daffa3aaf1363a5184c0d2dc55c78e3db4ec70241cdac97bf84b59 AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -o /out/tt ./cmd/tt

FROM gcr.io/distroless/static-debian13:nonroot@sha256:d62067879de890a1def9da0e7766b7d20810a5e5555cef8506b752437d7a3e88
COPY --from=build /out/tt /usr/local/bin/tt
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/tt"]
