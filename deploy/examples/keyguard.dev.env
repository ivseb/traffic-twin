# tt keyguard on the same host as tt-core (Unix socket): test installations only.
# Keys: tt keyguard genkey -type hmac -kid k1 -out /var/lib/tt/keys/hmac.keys
#       tt keyguard genkey -type ed25519 -kid policy-1 -out /var/lib/tt/keys/policy.key
#       tt keyguard genkey -type ed25519 -kid pack-1 -out /var/lib/tt/keys/pack.key
# Sources need the same HMAC key file (TT_HMAC_KEY_FILE).
TT_KEYGUARD_SOCKET=/var/lib/tt/keyguard.sock
TT_KEYGUARD_DB=/var/lib/tt/tt-keyguard.db
TT_KEYGUARD_HMAC_KEYS_FILE=/var/lib/tt/keys/hmac.keys
TT_KEYGUARD_POLICY_SIGNING_KEY_FILE=/var/lib/tt/keys/policy.key
TT_KEYGUARD_PACK_SIGNING_KEY_FILE=/var/lib/tt/keys/pack.key
