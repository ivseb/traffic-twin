{
    "name": "traffic-twin/sdk",
    "description": "traffic-twin capture SDK for PHP: sanitizes HTTP exchanges in the request, spools them locally and ships them to tt-core over mTLS.",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://github.com/ivseb/traffic-twin",
    "authors": [
        {
            "name": "traffic-twin maintainers",
            "homepage": "https://github.com/ivseb"
        }
    ],
    "support": {
        "issues": "https://github.com/ivseb/traffic-twin/issues",
        "source": "https://github.com/ivseb/traffic-twin/tree/main/sdk/php",
        "docs": "https://github.com/ivseb/traffic-twin/tree/main/sdk/php#readme"
    },
    "keywords": [
        "traffic-twin",
        "capture",
        "psr-15",
        "guzzle",
        "otlp"
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-hash": "*",
        "ext-pcre": "*"
    },
    "suggest": {
        "ext-sodium": "Required for capture: verifies the Ed25519 signature of policies. Without it the SDK refuses to capture (fail closed).",
        "ext-openssl": "Required by tt-shipper: enrollment (CSR), certificate pinning and mTLS.",
        "ext-zlib": "Needed to sanitize gzip/deflate bodies; without it such bodies are reported as drop:bytes.",
        "ext-pcntl": "Lets tt-shipper shut down cleanly on SIGTERM/SIGINT.",
        "psr/http-server-middleware": "PSR-15 middleware (TrafficTwin\\Integration\\Psr15Middleware).",
        "psr/http-message": "PSR-7 messages used by the PSR-15 and Guzzle integrations.",
        "guzzlehttp/guzzle": "Outbound capture (TrafficTwin\\Integration\\GuzzleMiddleware).",
        "open-telemetry/api": "If present, the active span context is read (never registered or modified)."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6",
        "open-telemetry/api": "^1.0",
        "illuminate/container": "^10.0 || ^11.0 || ^12.0",
        "illuminate/events": "^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0",
        "illuminate/routing": "^10.0 || ^11.0 || ^12.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/routing": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "TrafficTwin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TrafficTwin\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/tt-shipper"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": "phpunit",
        "vectors": "@php scripts/run-vectors.php"
    },
    "minimum-stability": "stable"
}
